# 复制为 .env 后填写；不要提交真实凭据。
NODEPOOL_IMAGE=ghcr.io/lectwolf/mihomo-nodepool:latest
HTTP_PORT=8080
HTTP_ADDR=:8080

# 管理员密码至少 8 字节；留空时自动生成到 data/admin-password。
ADMIN_PASSWORD=

# 现有 MySQL 8.0+。缺少配置时可以登录，但无法保存或导入节点。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_TLS=false

# 私有仓库 Release 下载需要目标仓库只读权限。不要使用示例或测试令牌。
UPDATE_GITHUB_TOKEN=
