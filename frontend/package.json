{
  "name": "mihomo-nodepool-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Mihomo NodePool 前端骨架。只准备系统状态页，不包含节点管理或版本更新。",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
